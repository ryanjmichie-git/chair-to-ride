{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "python .claude/hooks/phi_guard.py", "timeout": 10 },
          { "type": "command", "command": "python .claude/hooks/prompt_freeze.py", "timeout": 10 }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "python .claude/hooks/danger_guard.py", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "python .claude/hooks/pytest_quick.py", "timeout": 150 }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          { "type": "command", "command": "python .claude/hooks/render_timeline.py", "timeout": 90 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "python .claude/hooks/eval_gate.py", "timeout": 120 }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          { "type": "command", "command": "python .claude/hooks/session_brief.py", "timeout": 15 }
        ]
      }
    ]
  },
  "permissions": {
    "deny": ["Read(./data/real/**)", "Edit(./data/real/**)", "Write(./data/real/**)"]
  }
}
